# Optional AI integration. Leave blank to run Startup IQ without external API keys (uses robust local heuristic parser).
AI_API_KEY=
# Optional provider selection: 'auto', 'openai', or 'gemini'
AI_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------
# Authentication — User Accounts & Session Security (Phase 6)
# -----------------------------------------------------------------------
# JWT signing secret.  Must be at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a hardcoded development fallback is used — NEVER leave
# blank in production.
AUTH_JWT_SECRET=your-32-char-min-secret-key-here
